set(CMAKE_SYSTEM_NAME      Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(TOOLCHAIN_PREFIX arm-none-eabi-)
find_program(ARM_CC ${TOOLCHAIN_PREFIX}gcc REQUIRED)
get_filename_component(TOOLCHAIN_BIN ${ARM_CC} DIRECTORY)

set(CMAKE_C_COMPILER   ${TOOLCHAIN_BIN}/${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_ASM_COMPILER ${TOOLCHAIN_BIN}/${TOOLCHAIN_PREFIX}gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN_BIN}/${TOOLCHAIN_PREFIX}g++)
set(CMAKE_OBJCOPY      ${TOOLCHAIN_BIN}/${TOOLCHAIN_PREFIX}objcopy CACHE FILEPATH "" FORCE)
set(CMAKE_SIZE         ${TOOLCHAIN_BIN}/${TOOLCHAIN_PREFIX}size    CACHE FILEPATH "" FORCE)

# The compiler cannot link a hosted test binary without our linker script, so
# ask CMake to sanity-check it as a static library instead.
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
endif()
