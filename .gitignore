# build
build/
build-*/
_deps/
*.elf
*.bin
*.hex
*.map
*.o
*.obj
*.su
compile_commands.json
CMakeCache.txt
CMakeFiles/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# working captures get large and are not source
*.npz
captures/*

# ...but the committed evidence artifacts ARE source: they are what lets a
# reader reproduce the numbers in docs/measured-results.md.  Note the
# captures/* form above rather than captures/ - git cannot re-include a file
# inside an excluded *directory*, so the directory itself must stay listed.
!captures/reference/
!captures/reference/*.npz
!captures/reference/*.bin
!docs/img/
!docs/img/*.png
!docs/img/*.jpg
!hardware/**/*.pdf
!hardware/**/*.png

# editors
.vscode/
.idea/
*.swp
.DS_Store
